{
    "name": "uddoktapay/uddoktapay",
    "type": "project",
    "description": "UddoktaPay is a self-hosted payment management software.",
    "require": {
        "php": "^8.2"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Themes\\": "themes",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/Helpers/helpers.php"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}