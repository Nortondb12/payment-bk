{
    "name": "revoltify/gatewayify",
    "description": "The Revoltify Gateway package",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "ext-bcmath": "*",
        "ext-dom": "*",
        "ext-openssl": "*",
        "laravel/framework": "^11.0||^12.0||^13.0",
        "revoltify/support": "dev-main",
        "stripe/stripe-php": "^18.0"
    },
     "require-dev": {
        "laravel/pint": "^1.29.3",
        "orchestra/testbench": "^10.0",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.2",
        "pestphp/pest-plugin-type-coverage": "^3.6",
        "phpstan/phpstan": "^2.2.2",
        "rector/rector": "^2.5.2",
        "spatie/laravel-activitylog": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Revoltify\\Gatewayify\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Revoltify\\Gatewayify\\Tests\\": "tests"
        }
    },
    "scripts": {
        "lint": "pint",
        "refactor": "rector",
        "test:type-coverage": "@php -d memory_limit=512M vendor/bin/pest --type-coverage --min=100",
        "test:lint": "pint --test",
        "test:unit": "XDEBUG_MODE=\"coverage\" pest --parallel --coverage --exactly=100",
        "test:types": "phpstan",
        "test:refactor": "rector --dry-run",
        "test": [
            "@test:refactor",
            "@test:lint",
            "@test:type-coverage",
            "@test:types",
            "@test:unit"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Revoltify\\Gatewayify\\GatewayifyServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
