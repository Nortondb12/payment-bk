{
    "name": "revoltify/themeify",
    "description": "A minimal Laravel package for theme",
    "type": "library",
    "keywords": [
        "laravel",
        "theme"
    ],
    "license": "MIT",
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/revoltify/support"
        }
    ],
    "autoload": {
        "psr-4": {
            "Revoltify\\Themeify\\": "src/"
        }
    },
    "require": {
        "php": "^8.2",
        "inertiajs/inertia-laravel": "^3.3",
        "laravel/framework": "^12.0||^13.0",
        "revoltify/support": "dev-main"
    },
    "require-dev": {
        "larastan/larastan": "^3.9",
        "laravel/pint": "^1.29",
        "rector/rector": "^2.4"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Revoltify\\Themeify\\ThemeifyServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
