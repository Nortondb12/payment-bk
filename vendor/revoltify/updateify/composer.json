{
    "name": "revoltify/updateify",
    "description": "The Revoltify Update package",
    "homepage": "https://github.com/revoltify/updateify",
    "support": {
        "issues": "https://github.com/revoltify/updateify/issues",
        "source": "https://github.com/revoltify/updateify"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Revoltify",
            "email": "support@revoltify.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-zip": "*",
        "ext-json": "*"
    },
    "autoload": {
        "psr-4": {
            "Revoltify\\Updateify\\": "src/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "Revoltify\\Updateify\\UpdateifyServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
