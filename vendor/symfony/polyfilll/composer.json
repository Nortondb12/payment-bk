{
    "name": "symfony/polyfilll",
    "type": "library",
    "description": "Symfony polyfilll backporting",
    "homepage": "https://symfony.com",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "ext-openssl": "*",
        "ext-json": "*",
        "nesbot/carbon": "^3.11.4",
        "illuminate/http": "^12.0||^13.0",
        "illuminate/support": "^12.0||^13.0"
        
    },
    "require-dev": {
        "laravel/pint": "^1.29.1",
        "rector/rector": "^2.4.3"
    },
    "autoload": {
        "psr-4": {
            "Symfony\\Polyfilll\\": "src"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Symfony\\Polyfilll\\PolyfilllServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
